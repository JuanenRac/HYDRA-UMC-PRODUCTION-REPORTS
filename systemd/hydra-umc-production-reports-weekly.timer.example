# An example, not installed by anything here. Persistent=true runs a missed run at the next boot.
[Unit]
Description=HYDRA-UMC-PRODUCTION-REPORTS weekly reports timer

[Timer]
OnCalendar=Mon *-*-* 01:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
