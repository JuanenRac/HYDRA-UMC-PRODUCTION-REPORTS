# --addr 127.0.0.1 overrides this module's own 0.0.0.0 default - every
# other internal-only API on this CM5 (Datalake, Anomaly-Detector,
# Job-Dispatcher, Telemetry-Collector) is loopback-only, and this one has
# no authentication of its own either, so it stays consistent rather than
# accidentally being the one API reachable from the wider LAN.
[Unit]
Description=HYDRA-UMC-PRODUCTION-REPORTS real KPI/OEE reporting API
After=network-online.target hydra-umc-datalake.service
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-production-reports
Group=hydra-umc-production-reports
WorkingDirectory=/opt/hydra-umc/production-reports
Environment=PYTHONPATH=/opt/hydra-umc/production-reports/src
ExecStart=/usr/bin/python3 -m hydra_umc_production_reports.main --addr 127.0.0.1 --port 8099 --datalake-url http://127.0.0.1:8095
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
